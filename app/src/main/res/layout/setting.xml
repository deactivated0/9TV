<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:gravity="end|right"
    >
    <ScrollView
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:fillViewport="true"
        >
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@color/blur"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/title_blur"
                android:text="@string/app_name"
                android:textSize="16sp"
                android:layout_gravity="bottom" />
            <TextView
                android:id="@+id/version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/description_blur"
                android:text=""
                android:textSize="14sp"
                android:layout_gravity="bottom"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:textColor="@color/title_blur"
            android:text=""
            android:textSize="14sp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3"
            >
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/qrcode"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:textSize="11sp"
                android:text="@string/server" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/confirm_config"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:textSize="11sp"
                android:text="@string/channels" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/clear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="@string/clear"
                android:textSize="11sp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3"
            >
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/check_version"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:textSize="11sp"
                android:text="@string/check_version"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_search_keypad"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/search_channel"
                android:textSize="11sp"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/exit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="@string/exit"
                android:textSize="11sp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3"
            >
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_aspect_ratio"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:textSize="11sp"
                android:text="@string/aspect_ratio"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_resolution"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:textSize="11sp"
                android:text="@string/resolution"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_source_line"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="@string/switch_source"
                android:textSize="11sp"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3"
            >
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_playlists"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:textSize="11sp"
                android:text="@string/playlists_manager"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_audio_track"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/audio_track"
                android:textSize="11sp"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_subtitle_track"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="@string/subtitle_track"
                android:textSize="11sp"
                />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_channel_reversal"
            android:text="@string/title_channel_reversal"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_channel_num"
            android:text="@string/title_channel_num"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_time"
            android:text="@string/title_time"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_boot_startup"
            android:text="@string/title_boot_startup"
            android:textColor="@color/title_blur"
            android:layout_marginTop="5dp"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_repeat_info"
            android:text="@string/title_repeat_info"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_config_auto_load"
            android:text="@string/title_config_auto_load"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_default_like"
            android:text="@string/title_default_like"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_show_all_channels"
            android:text="@string/show_all_channels"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_compact_menu"
            android:text="@string/compact_menu"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_display_seconds"
            android:text="@string/display_seconds"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_dark_mode"
            android:text="@string/title_dark_mode"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_prefer_sw_decoder"
            android:text="@string/title_prefer_software_decoder"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_stream_hud"
            android:text="@string/title_stream_hud"
            android:textColor="@color/title_blur"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color"
            />
    </LinearLayout>
    </ScrollView>
</LinearLayout>